# ─────────────────────────────────────────────────────────────────────────────
# CRM Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the required values.
# The CRM works with any hosting platform (Vercel, Railway, Render, Docker, etc.)

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (URL-encode special chars in password with %XX)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/crm_db?retryWrites=true&w=majority

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret-here
# Base URL of your deployment
NEXTAUTH_URL=http://localhost:3000

# ── Social Token Encryption (optional) ──────────────────────────────────────
# AES-256 key for encrypting social media tokens
# Generate with: openssl rand -hex 32
# Falls back to NEXTAUTH_SECRET if not set; set explicitly in production
SOCIAL_TOKEN_ENCRYPTION_KEY=

# ── Meta (Facebook + Instagram) ─────────────────────────────────────────────
# Create app at: https://developers.facebook.com/apps
# Required permissions: instagram_basic, instagram_content_publish,
#   instagram_manage_insights, pages_manage_posts, pages_read_engagement
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=           # usually same as FACEBOOK_APP_ID
INSTAGRAM_APP_SECRET=       # usually same as FACEBOOK_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=  # any random string you choose
META_APP_SECRET=            # same as FACEBOOK_APP_SECRET (used for HMAC verification)

# ── Twitter / X ──────────────────────────────────────────────────────────────
# Create app at: https://developer.twitter.com/en/portal
# Required scopes: tweet.read tweet.write users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CONSUMER_SECRET=    # Consumer Secret for webhook HMAC (v1.1 keys)

# ── LinkedIn ─────────────────────────────────────────────────────────────────
# Create app at: https://developer.linkedin.com
# Required scopes: r_basicprofile w_member_social r_organization_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── TikTok ───────────────────────────────────────────────────────────────────
# Create app at: https://developers.tiktok.com
# Required scopes: user.info.basic video.publish video.upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Stripe (Payments) ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── SendGrid (Email) ────────────────────────────────────────────────────────
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Partner Integration (optional) ──────────────────────────────────────────
# If your deployment uses a partner integration (e.g., clinical partner for
# healthcare), configure the partner webhook endpoint here.
# PARTNER_API_URL=
# PARTNER_API_KEY=
# PARTNER_WEBHOOK_SECRET=

# ── Cron Jobs ────────────────────────────────────────────────────────────────
# Secret for authenticating cron job requests (set by your hosting platform,
# or generate manually for self-hosted deployments)
# CRON_SECRET=

# ── Frontend URL (optional) ─────────────────────────────────────────────────
# Public URL of a customer-facing site that feeds leads into this CRM
# NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com
