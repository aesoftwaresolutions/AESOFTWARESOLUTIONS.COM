# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aecrm?retryWrites=true&w=majority

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_URL=https://crm.aesoftwaresolutions.com

# ── Tenant ────────────────────────────────────────────────────────────────────
# Options: general-business | mortgage-lending | real-estate | healthcare | saas | retail-ecommerce
NEXT_PUBLIC_TENANT_PRESET=general-business

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://crm.aesoftwaresolutions.com
NODE_ENV=production
